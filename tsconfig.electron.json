{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-electron",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.electron.tsbuildinfo"
  },
  "include": ["electron", "shared"]
}
