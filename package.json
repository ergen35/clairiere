{
  "name": "clairiere",
  "productName": "Clairière",
  "version": "0.3.0",
  "private": true,
  "description": "Analyses your disks at full speed and frees up space. Linux, Windows and macOS.",
  "author": {
    "name": "Serge Eric Hotegni",
    "url": "https://github.com/ergen35"
  },
  "homepage": "https://github.com/ergen35/clairiere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergen35/clairiere.git"
  },
  "bugs": {
    "url": "https://github.com/ergen35/clairiere/issues"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc -b && vite build && node scripts/build-engine.mjs && node scripts/prepare-electron.mjs",
    "package": "npm run build && node scripts/package-deb.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never",
    "start": "./clairiere",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
